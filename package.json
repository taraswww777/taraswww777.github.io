  "description": "Site Taras Kovalev (taraswww777). U can see taraswww777.github.io",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild-exclude-admin.js",
    "start": "next start",
    "lint": "next lint",
    "sitemap": "node scripts/sitemap-generator.js",
    "test": "jest",
    "deploy": "npm run build && npm run sitemap",
    "version:patch": "npm version patch",
    "docker:rebuild": "npm run docker:rmi && npm run docker:build",
    "docker:rmi": "docker rmi taraswww777/taraswww777-fe .",
    "docker:build": "docker build -t taraswww777/taraswww777-fe .",
    "docker:run": "docker run -d -p 80:4000 --name taraswww777-fe --rm taraswww777/taraswww777-fe",
    "docker:stop": "docker stop taraswww777-fe",
    "docker:push": "docker push taraswww777/taraswww777-fe:latest"
  },
